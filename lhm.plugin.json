    {
      "name": "get_products",
      "description": "Look up 1–20 exact product IDs or SKUs; return public MSRP and indicative availability when displayed by this storefront.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storefront": {
            "type": "string",
            "enum": [
              "eu",
              "pl"
            ]
          },
          "language": {
            "default": "en",
            "type": "string",
            "enum": [
              "en",
              "pl",
              "de",
              "fr",
              "es",
              "it",
              "cs",
              "ro",
              "hu",
              "bg",
              "lt",
              "ar"
            ]
          },
          "products": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[1-9]\\d{0,9}$"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "sku": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160,
                      "pattern": "^[^\\x00-\\x1f\\x7f<>]+$"
                    }
                  },
                  "required": [
                    "sku"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "storefront",
          "products"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },

    {
      "name": "calculate_cable_route",
      "description": "Use the native Modulit cable calculator. Enter actual sections in metres, loops, installation route and allowance. Result is required cable length, not a certification of signal reach.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storefront": {
            "type": "string",
            "enum": [
              "eu",
              "pl"
            ]
          },
          "horizontalM": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "riseM": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "dropM": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "loopFromM": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "loopToM": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "travelM": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "routing": {
            "default": "direct",
            "type": "string",
            "enum": [
              "direct",
              "tray",
              "raceway",
              "conduit"
            ]
          },
          "signal": {
            "default": "unspecified",
            "type": "string",
            "enum": [
              "unspecified",
              "hdmi18",
              "hdmi48",
              "hdbt",
              "network",
              "usb2",
              "usb3",
              "usbc",
              "dp",
              "sdi12",
              "sdi3",
              "audio",
              "unbalanced",
              "rs232",
              "fiber",
              "speaker",
              "power",
              "dmx",
              "vga",
              "dvi",
              "kvm",
              "dac",
              "conversion",
              "other"
            ]
          },
          "wastePercent": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "quantity": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "storefront",
          "horizontalM"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false

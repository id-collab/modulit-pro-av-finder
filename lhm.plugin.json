{
  "author": "UAB Modulit Solutions",
  "authorUrl": "https://www.modulit.eu/",
  "cloudEndpoint": "https://www.modulit.eu/mcp",
  "description": "Search Modulit EU and PL pro AV equipment and installation guides, compare alternatives, calculate cable runs and configure AV hardware. Read-only guest access with storefront commercial visibility.",
  "homepage": "https://www.modulit.eu/mcp-guide/",
  "identifier": "id-collab-modulit-pro-av-finder",
  "name": "Modulit Pro AV Finder",
  "prompts": [],
  "resources": [],
  "tools": [
    {
      "name": "search_site",
      "description": "Find published solutions, guides, tools and products for a task, model or SKU. Catalogue links identify published pages; only structured facts support compatibility. Use get_products for current terms.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storefront": {
            "type": "string",
            "enum": [
              "eu",
              "pl"
            ]
          },
          "language": {
            "default": "en",
            "type": "string",
            "enum": [
              "en",
              "pl",
              "de",
              "fr",
              "es",
              "it",
              "cs",
              "ro",
              "hu",
              "bg",
              "lt",
              "ar"
            ]
          },
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[^\\x00-\\x1f\\x7f<>]+$"
          },
          "filters": {
            "type": "object",
            "properties": {
              "technical": {
                "type": "object",
                "properties": {
                  "brand": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "application": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "videoMode": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "minLengthM": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  "maxLengthM": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  }
                },
                "additionalProperties": false
              },
              "maxMsrp": {
                "type": "object",
                "properties": {
                  "amountMinor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "amountMinor",
                  "currency"
                ],
                "additionalProperties": false
              },
              "availability": {
                "type": "string",
                "enum": [
                  "not_in_stock",
                  "low",
                  "in_stock",
                  "high",
                  "backorder"
                ]
              }
            },
            "additionalProperties": false
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "storefront",
          "q"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },

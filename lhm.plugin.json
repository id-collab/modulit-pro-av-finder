    {
      "name": "configure_power",
      "description": "Run the native SurgeX equipment selector for this storefront. Missing evidence is counted separately.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storefront": {
            "type": "string",
            "enum": [
              "eu",
              "pl"
            ]
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "number"
                },
                {
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 80
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "storefront",
          "values"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false

    {
      "name": "configure_mediahub",
      "description": "Inspect the native PureLink mediahub2 choices, or resolve a housing, preset, socket, covers, mount and quantity into an actual bill of materials. Omit state to list choices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storefront": {
            "type": "string",
            "enum": [
              "eu",
              "pl"
            ]
          },
          "state": {
            "type": "object",
            "properties": {
              "enc": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "pre": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "hc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "s": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "rc": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cvr": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "gst": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "mnt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sets": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
